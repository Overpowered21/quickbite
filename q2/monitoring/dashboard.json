{
  "uid": "q2-model-monitoring",
  "title": "Q2 — Model API monitoring",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": ["q2", "mlflow"],
  "timezone": "browser",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "API scrape availability (1 = up)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 5},
      "datasource": {"type": "prometheus", "uid": "q2-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"model-service\"}", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2,
      "title": "Loaded model version (1 = loaded)",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 5},
      "datasource": {"type": "prometheus", "uid": "q2-prometheus"},
      "targets": [{"refId": "A", "expr": "model_loaded{job=\"model-service\"}", "instant": true, "legendFormat": "{{model_name}} v{{version}}"}],
      "options": {"textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3,
      "title": "Prediction requests per second",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "q2-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(model_http_requests_total{job=\"model-service\",route=\"/predict\"}[1m]))", "legendFormat": "requests/s"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 4,
      "title": "Prediction request errors (4xx/5xx)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "q2-prometheus"},
      "targets": [{"refId": "A", "expr": "(sum(rate(model_http_requests_total{job=\"model-service\",route=\"/predict\",status_code=~\"4..|5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(model_http_requests_total{job=\"model-service\",route=\"/predict\"}[1m])), 0.000001)", "legendFormat": "error ratio"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 5,
      "title": "Prediction latency — p95",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 13, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "q2-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(model_http_request_duration_seconds_bucket{job=\"model-service\",route=\"/predict\"}[1m])))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    }
  ]
}
